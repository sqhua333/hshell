{
  "name": "hshell",
  "version": "0.1.0",
  "description": "HShell - a cross-platform SSH and serial client",
  "homepage": "https://example.com/hshell",
  "desktopName": "com.hshell.app.desktop",
  "main": "./out/main/index.js",
  "author": "HShell <hshell@example.com>",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts",
    "mock:sshd": "node scripts/mock-sshd.mjs",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win:portable": "npm run build && electron-builder --win portable",
    "dist:win:zip": "npm run build && electron-builder --win zip",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:dir": "npm run build && electron-builder --dir",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "e2e:drag-split": "node scripts/e2e-drag-split.mjs",
    "e2e:timestamps": "node scripts/e2e-terminal-stamps.mjs",
    "e2e:password": "node scripts/e2e-password-prompt.mjs",
    "icon": "python3 scripts/gen-icon.py"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.5",
    "serialport": "^13.0.0",
    "ssh2": "^1.17.0",
    "zmodem.js": "^0.1.10",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  }
}
